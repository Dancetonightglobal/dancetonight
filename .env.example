# DanceTonight environment variables. Copy to .env.local for local runs.
# Secrets never enter the repository: real values live in Vercel project settings and
# the fixed-IP worker's environment. With no keys at all, `pnpm dev` runs in mock mode.

# ---- Mode and site ----------------------------------------------------------------
DANCETONIGHT_MODE=mock                  # mock | preview | production. mock: seed data, no keys needed
PUBLIC_BASE_URL=http://localhost:3000   # the site's public address (Vercel preview URL until a domain exists)
BOT_CONTACT_EMAIL=                      # contact address in the crawler's User-Agent and on /bot (D-021)
ADMIN_EMAILS=                           # comma-separated addresses allowed to sign in to /admin
DIGEST_TO=                              # where the daily digest email goes
CRON_SECRET=                            # unused: Inngest schedules everything (D-012); kept for Vercel parity

# ---- Database (Supabase Postgres with PostGIS and pg_trgm) ---------------------------
DATABASE_URL=                           # transaction pooler URL (port 6543); prepared statements disabled
DIRECT_DATABASE_URL=                    # session pooler URL (port 5432) for migrations; not the IPv6-only direct address
SUPABASE_URL=                           # project URL, for Storage and Auth
SUPABASE_ANON_KEY=                      # public anon key (admin sign-in UI)
SUPABASE_SERVICE_ROLE_KEY=              # server-only service key (Storage writes, admin queries)

# ---- Jobs, caches, monitoring ----------------------------------------------------------
INNGEST_EVENT_KEY=                      # Inngest Cloud event key (D-012)
INNGEST_SIGNING_KEY=                    # Inngest Cloud signing key
UPSTASH_REDIS_REST_URL=                 # per-domain rate limits, robots cache, hot list cache
UPSTASH_REDIS_REST_TOKEN=
SENTRY_DSN=                             # errors and job failures
SENTRY_AUTH_TOKEN=                      # source map upload at build time
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=           # cookieless analytics (D-022); empty disables the script
RESEND_API_KEY=                         # daily digest and admin sign-in email (D-023)
CRAWLER_SIGNING_KEY=                    # Web Bot Auth private key for signed crawler requests (D-021)

# ---- Tier A sources (official APIs and open data, default ON) --------------------------
TICKETMASTER_API_KEY=                   # Discovery API consumer key
EVENTBRITE_PRIVATE_TOKEN=               # Eventbrite API v3 private token (API only, D-015)
MEETUP_CLIENT_KEY=                      # only with Meetup Pro and an approved OAuth client (Q6: start free)
MEETUP_CLIENT_SECRET=
MEETUP_MEMBER_ID=
MEETUP_JWT_PRIVATE_KEY=                 # RSA private key for the server-to-server JWT flow (PEM, base64)
GOOGLE_MAPS_SERVER_KEY=                 # Places API (New), restricted to it: place IDs by id-only Text Search at ingest (D-014, D-066)
GOOGLE_CALENDAR_API_KEY=                # public Google Calendars through the Calendar API v3, a key restricted to it (D-033, D-130); the ICS address is robots-closed
GEOAPIFY_API_KEY=                       # address geocoding and autocomplete (D-013, D-016)
PIKE13_CLIENT_ID=                       # public studio schedules (D-018)
SOCRATA_APP_TOKEN_NYC=                  # NYC Open Data app token (NYC Parks events; hidden pending D-034)
SOCRATA_APP_TOKEN_AUSTIN=               # Austin Open Data app token (library events)
PARIS_DATA_API_KEY=                     # opendata.paris.fr key (optional)
TEAMUP_API_KEY=                         # Teamup JSON API (only for calendars without an exposed ICS)
HELLOASSO_CLIENT_ID=                    # HelloAsso v5 OAuth2 client (French metros, D-029)
HELLOASSO_CLIENT_SECRET=
BILLETTO_API_KEY=                       # "id:secret" pair (Nordic and UK metros)
TICKSTER_API_KEY=                       # Tickster Event API (Sweden, Norway)
FIENTA_API_KEY=                         # per-organiser public events (optional)
MOSHTIX_API_KEY=                        # optional; anonymous reads work (Australia, New Zealand)
AGENDATRAD_RSS_URL=                     # personal Agenda Trad RSS URL (account-gated)
OPENAGENDA_API_KEY=                     # OpenAgenda publishable read key
WEEZEVENT_API_KEY=                      # partner key, only if granted
FOURSQUARE_OS_TOKEN=                    # Foursquare OS Places catalog token (flag FOURSQUARE_OS_PLACES, default off)

# ---- Tier B sources (paid, swappable) ------------------------------------------------------
SERP_PROVIDER=hasdata                   # hasdata | serper | serpapi (discovery provider, D-017)
HASDATA_API_KEY=
SERPER_API_KEY=                          # the one gap measurement only (D-125, ACCOUNTS 3f): pnpm eval:serper-gap
SERPAPI_API_KEY=
FIRECRAWL_API_KEY=                      # rendering for client-side pages only (D-026)
SEATGEEK_CLIENT_ID=                     # recall evaluation
SKIDDLE_API_KEY=                        # Skiddle events API (UK metros, D-204); free key
SABAKI_API_KEY=                         # Sabaki Partner API (Miami, Barcelona; D-324); free key, hand-approved
PREDICTHQ_TOKEN=                        # evaluation only
JAMBASE_API_KEY=                        # evaluation only

# ---- Tier C: AI (free providers, routed by data policy; D-039) --------------------------------
CLOUDFLARE_ACCOUNT_ID=                  # Workers AI account id, from the dashboard URL; 10,000 neurons/day free
CLOUDFLARE_AI_TOKEN=                    # Workers AI API token, "Workers AI" template, Read permission
GEMINI_API_KEY=                         # Google AI Studio key; own-facts jobs only, its free tier trains on input
GROQ_API_KEY=                           # Groq key; short own-facts jobs only, its 8,000 tokens/min cannot hold a page
OPENROUTER_API_KEY=                     # OpenRouter key; own-facts jobs only, free models may train on and publish input
AI_PROVIDER_ORDER=gemini,groq,openrouter,cloudflare  # own-facts chain, owner's order; page text still goes to Cloudflare alone
AI_DAILY_NEURON_BUDGET=9000             # OUR ceiling, deliberately below Cloudflare's verified 10,000, so we stop before the vendor refuses
AI_METRO_NEURON_CAP=4500                # the most one metro may spend in a day (floor(daily / 2)), so a cold start cannot take the day
AI_DAILY_REQUEST_BUDGET=50              # requests/day for a request-metered provider; OpenRouter's verified no-credit figure
CLOUDFLARE_WORKERS_PAID=false           # true only once the Cloudflare account is on Workers Paid; lets AI_DAILY_NEURON_BUDGET go above the free 10,000 (D-058)
AI_ENABLE_PAID=false                    # true switches the paid providers on (Bedrock, Anthropic); each also needs its own key
ANTHROPIC_API_KEY=                      # off unless AI_ENABLE_PAID is set; paid fallback only (D-039 supersedes D-007)
BEDROCK_ACCESS_KEY_ID=                  # paid DeepSeek V3.2 on Amazon Bedrock (D-142); a dedicated IAM user limited to bedrock:InvokeModel on that model
BEDROCK_SECRET_ACCESS_KEY=              # its secret; off unless AI_ENABLE_PAID is set
BEDROCK_SESSION_TOKEN=                  # only for temporary credentials; leave empty for the IAM user's long-lived key
BEDROCK_INFERENCE_PROFILE_ARN=          # optional: this project's tagged application inference profile ARN (cost allocation)
AI_DAILY_USD_CAP=1                      # dollars per day the paid provider may spend, account-wide (D-142)
AI_METRO_USD_CAP=                       # the most dollars one metro may spend in a day; empty = half of AI_DAILY_USD_CAP

# ---- Tier D and organizer connect (flags default OFF; see config/flags.ts) -----------------
EDMTRAIN_API_KEY=                       # only after written permission (D-029)
DISCORD_CLIENT_ID=                      # organizer connect: Discord scheduled events (D-030, after v1)
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=                     # organizer connect: Telegram admin bot (after the legal read, D-030)

# ---- Abuse guard and map ------------------------------------------------------------------------
TURNSTILE_SITE_KEY=                     # Cloudflare Turnstile (cold starts and submissions)
TURNSTILE_SECRET_KEY=
TILES_FALLBACK_URL=                     # Protomaps tiles on R2 if OpenFreeMap is unavailable (D-013)

# Tests
TEST_DATABASE_URL=                      # a disposable Postgres with PostGIS for the write-path tests; each test file creates its own database under it (needs CREATEDB). CI sets it.

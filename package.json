{
  "name": "dancetonight",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/copy-maplibre-worker.mjs && next dev",
    "build": "node scripts/copy-maplibre-worker.mjs && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate && tsx src/db/unquote-geography.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:check": "tsx src/db/check-connection.ts",
    "ai:check": "tsx src/jobs/ai-check.ts",
    "db:seed": "tsx src/db/seed/run.ts",
    "ingest": "tsx src/jobs/ingest.ts",
    "dedupe:unmerge": "tsx src/jobs/dedupe-unmerge.ts",
    "link:check": "tsx src/jobs/link-check.ts",
    "archive:past": "tsx src/jobs/archive-past.ts",
    "review:screen": "tsx src/jobs/review-screen.ts",
    "sabaki:probe": "tsx src/jobs/sabaki-probe.ts",
    "discover": "tsx src/jobs/discover.ts",
    "eval:extraction": "tsx evals/extraction/run.ts",
    "eval:refresh": "tsx evals/refresh/replay.ts",
    "eval:recall": "tsx evals/recall/run.ts",
    "eval:serper-gap": "tsx src/jobs/serper-gap.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "seed:venues": "tsx src/jobs/seed-venues.ts",
    "ai:probe": "tsx src/jobs/ai-probe.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "any-ascii": "0.3.3",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "geo-tz": "^8.1.9",
    "maplibre-gl": "^6.10.0",
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rrule-temporal": "^2.2.6",
    "tldts": "^7.4.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.10",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1",
    "wrangler": "^4.149.0"
  }
}
